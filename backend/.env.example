TARA_ENVIRONMENT=development
TARA_LOG_LEVEL=INFO
TARA_HOST=127.0.0.1
TARA_PORT=8000
TARA_SERVICE_SECRET=replace-with-a-local-development-placeholder
TARA_DATABASE_URL=sqlite+aiosqlite:///./data/tara.db
TARA_STT_PROVIDER=disabled
TARA_STT_MODEL=small
TARA_STT_DEVICE=cpu
TARA_STT_COMPUTE_TYPE=int8
TARA_STT_TIMEOUT_SECONDS=30
TARA_STT_MAX_QUEUED_JOBS=8
TARA_STT_MAX_CONCURRENT_JOBS=1
TARA_STT_REQUIRED=false
TARA_STT_HEALTH_TIMEOUT_MS=500
TARA_STT_LANGUAGE_HINT=
TARA_STT_PARTIAL_MODE=provider
TARA_STT_LOCAL_MODEL_DIRECTORY=
TARA_LLM_PROVIDER=disabled
TARA_LLM_REQUIRED=false
TARA_OLLAMA_BASE_URL=http://127.0.0.1:11434
TARA_OLLAMA_MODEL=
TARA_LLM_TIMEOUT_SECONDS=30
TARA_LLM_CONTEXT_TOKEN_BUDGET=4096
TARA_LLM_OUTPUT_TOKEN_BUDGET=512
TARA_LLM_TEMPERATURE=0.2
TARA_LLM_STREAMING=false
TARA_AGENT_INTENT_CONFIDENCE_THRESHOLD=0.75
TARA_AGENT_CONTEXT_MEMORY_LIMIT=8
TARA_AGENT_CONTEXT_RECENT_TURN_LIMIT=8
TARA_AGENT_CONTEXT_MEMORY_ITEM_CHAR_LIMIT=512
TARA_AGENT_CONTEXT_RECENT_TURN_CHAR_LIMIT=768
TARA_AGENT_CONTEXT_TOTAL_CHAR_LIMIT=4096
TARA_AGENT_CONTEXT_ESTIMATED_TOKEN_LIMIT=1024
# JSON array; normal is the only default. restricted is never permitted.
TARA_AGENT_CONTEXT_ALLOWED_SENSITIVITIES=["normal"]
TARA_AGENT_REQUEST_TIMEOUT_SECONDS=30
TARA_AGENT_MAX_QUEUED_REQUESTS=8
TARA_AGENT_MAX_CONCURRENT_REQUESTS=1
TARA_AGENT_MAX_REQUESTS_PER_CONNECTION=2
TARA_AGENT_MAX_REQUESTS_PER_SESSION=4
TARA_AGENT_MAX_REQUESTS_PER_OWNER=8
TARA_AGENT_MAX_TERMINAL_RECORDS=32
TARA_AGENT_TERMINAL_RETENTION_SECONDS=300
