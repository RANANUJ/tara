TARA_ENVIRONMENT=development
TARA_LOG_LEVEL=INFO
TARA_HOST=127.0.0.1
TARA_PORT=8000
TARA_SERVICE_SECRET=replace-with-a-local-development-placeholder
# Required before enabling the M16 scheduler. Generate locally with:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TARA_TASK_PAYLOAD_ENCRYPTION_KEY=
TARA_SCHEDULER_RUN_TIMEOUT_SECONDS=30
TARA_DATABASE_URL=sqlite+aiosqlite:///./data/tara.db
TARA_STT_PROVIDER=disabled
TARA_STT_MODEL=small
TARA_STT_DEVICE=cpu
TARA_STT_COMPUTE_TYPE=int8
TARA_STT_TIMEOUT_SECONDS=30
TARA_STT_MAX_QUEUED_JOBS=8
TARA_STT_MAX_CONCURRENT_JOBS=1
TARA_STT_REQUIRED=false
TARA_STT_HEALTH_TIMEOUT_MS=500
TARA_STT_LANGUAGE_HINT=
TARA_STT_PARTIAL_MODE=provider
TARA_STT_LOCAL_MODEL_DIRECTORY=
TARA_TTS_PROVIDER=disabled
TARA_TTS_REQUIRED=false
TARA_TTS_MAX_TEXT_CHARACTERS=4000
TARA_TTS_MAX_AUDIO_BYTES=8388608
TARA_TTS_TIMEOUT_SECONDS=30
# M10B uses a process-local FIFO queue. Audio is transient and never stored in SQLite.
TARA_TTS_MAX_QUEUED_REQUESTS=8
TARA_TTS_MAX_CONCURRENT_REQUESTS=1
TARA_TTS_MAX_REQUESTS_PER_CONNECTION=2
TARA_TTS_MAX_REQUESTS_PER_SESSION=4
TARA_TTS_MAX_REQUESTS_PER_OWNER=8
TARA_TTS_MAX_CHUNK_BYTES=8192
TARA_TTS_MAX_TERMINAL_RECORDS=32
TARA_TTS_TERMINAL_RETENTION_SECONDS=300
TARA_TTS_MAX_RETAINED_AUDIO_BYTES=33554432
TARA_TTS_DELIVERY_TIMEOUT_SECONDS=5
TARA_TTS_OUTPUT_ENCODING=pcm_s16le
TARA_TTS_OUTPUT_SAMPLE_RATE=22050
TARA_TTS_OUTPUT_CHANNELS=1
TARA_TTS_LANGUAGE_MODE=auto
TARA_TTS_VOICE_IDENTIFIER=
# Piper must be explicitly provisioned outside this repository; no model is downloaded automatically.
TARA_TTS_PIPER_EXECUTABLE=
TARA_TTS_PIPER_VOICE_MODEL_PATH=
TARA_TTS_PIPER_VOICE_CONFIG_PATH=
# Keep empty unless the optional cloud provider is explicitly selected. Never commit a real key.
TARA_ELEVENLABS_API_KEY=
TARA_ELEVENLABS_MODEL=
# M11A wake-word detection is disabled by default and foreground-only. Fake is development/test only.
# No local wake-word engine is selected yet; no model is downloaded automatically.
TARA_WAKEWORD_PROVIDER=disabled
TARA_WAKEWORD_ENABLED=false
TARA_WAKEWORD_PHRASE=tara
TARA_WAKEWORD_CONFIDENCE_THRESHOLD=0.85
TARA_WAKEWORD_MINIMUM_CONSECUTIVE_DETECTIONS=2
TARA_WAKEWORD_COOLDOWN_SECONDS=3
TARA_WAKEWORD_DEBOUNCE_SECONDS=1
TARA_WAKEWORD_FRAME_DURATION_MS=20
TARA_WAKEWORD_MAXIMUM_BUFFERED_FRAMES=8
TARA_WAKEWORD_LANGUAGE_MODE=auto
TARA_WAKEWORD_FOREGROUND_ONLY=true
TARA_WAKEWORD_MAXIMUM_FRAME_AGE_SECONDS=2
# SQLite remains authoritative. ChromaDB is an optional local, rebuildable semantic index.
TARA_MEMORY_SEMANTIC_PROVIDER=disabled
TARA_MEMORY_CHROMA_DIRECTORY=./data/chroma
TARA_MEMORY_SCHEDULER_ENABLED=true
# M13 read-only local capability. Keep disabled unless roots are explicitly provisioned.
TARA_TOOLS_FILESYSTEM_READ_ENABLED=false
TARA_TOOLS_FILESYSTEM_READ_ROOTS=[]
# M14 non-production confirmation harness; no external side effect is ever performed.
TARA_FAKE_CONSEQUENTIAL_ENABLED=false
TARA_FAKE_CONSEQUENTIAL_UNCERTAIN=false
TARA_LLM_PROVIDER=disabled
TARA_LLM_REQUIRED=false
TARA_OLLAMA_BASE_URL=http://127.0.0.1:11434
TARA_OLLAMA_MODEL=
# Optional M15 tier-specific local models. When blank, both tiers use OLLAMA_MODEL.
TARA_OLLAMA_FAST_MODEL=
TARA_OLLAMA_REASONING_MODEL=
TARA_LLM_TIMEOUT_SECONDS=30
TARA_LLM_CONTEXT_TOKEN_BUDGET=4096
TARA_LLM_OUTPUT_TOKEN_BUDGET=512
TARA_LLM_TEMPERATURE=0.2
TARA_LLM_STREAMING=false
# M9 uses final-only agent responses. Direct text is WebSocket-only; no REST agent endpoint exists.
TARA_AGENT_INTENT_CONFIDENCE_THRESHOLD=0.75
TARA_AGENT_CONTEXT_MEMORY_LIMIT=8
TARA_AGENT_CONTEXT_RECENT_TURN_LIMIT=8
TARA_AGENT_CONTEXT_MEMORY_ITEM_CHAR_LIMIT=512
TARA_AGENT_CONTEXT_RECENT_TURN_CHAR_LIMIT=768
TARA_AGENT_CONTEXT_TOTAL_CHAR_LIMIT=4096
TARA_AGENT_CONTEXT_ESTIMATED_TOKEN_LIMIT=1024
# JSON array; normal is the only default. restricted is never permitted.
TARA_AGENT_CONTEXT_ALLOWED_SENSITIVITIES=["normal"]
TARA_AGENT_REQUEST_TIMEOUT_SECONDS=30
TARA_AGENT_MAX_TOOL_ITERATIONS=2
TARA_AGENT_MAX_QUEUED_REQUESTS=8
TARA_AGENT_MAX_CONCURRENT_REQUESTS=1
TARA_AGENT_MAX_REQUESTS_PER_CONNECTION=2
TARA_AGENT_MAX_REQUESTS_PER_SESSION=4
TARA_AGENT_MAX_REQUESTS_PER_OWNER=8
TARA_AGENT_MAX_TERMINAL_RECORDS=32
TARA_AGENT_TERMINAL_RETENTION_SECONDS=300
